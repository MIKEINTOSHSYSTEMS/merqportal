# This file contains environment variables for the development environment.
# It is used to configure the database, pgAdmin, and Metabase settings.
# Make sure to keep this file secure and do not share sensitive information publicly.
# Database Configuration
# Note: Ensure that the database names, usernames, and passwords are unique and secure.

# BASE URL and Host Configuration
BASE_URL=app.merqconsultancy.org

# PostgreSQL Configuration
POSTGRES_DB=merqportalmeta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mikeintosh
POSTGRES_ROOT_PASSWORD=

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION=True
PGADMIN_CONFIG_CONSOLE_LOG_LEVEL=10

# Metabase Configuration
MB_DB_TYPE=postgres
MB_DB_DBNAME=merqportalmeta
MB_DB_PORT=5432
MB_DB_USER=postgres
MB_DB_PASS=mikeintosh
MB_ADMIN_EMAIL=admin@cloud.merqconsultancy.org
MB_ADMIN_FIRST_NAME=MERQPORTAL
MB_ADMIN_PASSWORD=merqapp_portal7
MB_SITE_URL=viz.app.merqconsultancy.org/
MB_SECRET_KEY=6ff67688469238cd9cfe9cf56f1262ae06fd5efd4d6d0dffa8a7f6b4b8046d6c

# Network Configuration
NETWORK_SUBNET=192.168.44.0/24
NETWORK_GATEWAY=192.168.44.1

# Container IP Addresses
DB_HOST=localhost
DB_IP=192.168.44.10
PGADMIN_IP=
METABASE_IP=192.168.44.20
MARIADB_IP=127.0.0.1
PHPMYADMIN_IP=127.0.0.1
#MATOMO_IP=

# Port Mappings
POSTGRES_PORT=5432
PGADMIN_PORT=5445
METABASE_PORT=4004
PHPMYADMIN_PORT=
MATOMO_PORT=

# DHIS2 Configuration
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
# DHIS2_API_KEY=1234567890abcdef1234567890abcdef


# Application Settings
DEBUG_MODE=true
CACHE_ENABLED=true
CACHE_DURATION=3600
MAX_RETRIES=3
TIMEOUT=30

# Azure AD Configuration
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=

# MariaDB Configuration
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

# Timezone Configuration
TZ=UTC